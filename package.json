{
	"name": "vite-plugin-vue-ce",
	"description": "Vite plugin for auto registering Vue custom elements imported from HTML",
	"keywords": [
		"vite",
		"vue",
		"ce"
	],
	"homepage": "https://github.com/hsl0/vite-plugin-vue-ce#readme",
	"bugs": {
		"url": "https://github.com/hsl0/vite-plugin-vue-ce/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hsl0/vite-plugin-vue-ce.git"
	},
	"license": "MIT",
	"author": "hsl0",
	"type": "module",
	"exports": {
		".": {
			"default": "./dist/index.js",
			"types": "./types/index.d.ts"
		}
	},
	"main": "dist/index.js",
	"types": "types/index.d.ts",
	"directories": {
		"test": "test"
	},
	"files": [
		"dist",
		"types"
	],
	"scripts": {
		"test": "vitest run",
		"build": "tsc",
		"lint": "eslint",
		"fix-lint": "eslint --fix",
		"format": "prettier --write .",
		"check-format": "prettier --check ."
	},
	"dependencies": {
		"cheerio": "^1.2.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.0.1",
		"@eslint/markdown": "^8.0.3",
		"@types/node": "^26.1.1",
		"@vitest/coverage-v8": "^4.1.10",
		"acorn": "^8.17.0",
		"eslint": "^10.7.0",
		"eslint-plugin-vue": "^10.9.2",
		"globals": "^17.7.0",
		"jiti": "^2.7.0",
		"prettier": "^3.9.5",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.63.0",
		"vite": "^8.1.4",
		"vitest": "^4.1.4"
	},
	"peerDependencies": {
		"vite": "~5 || ~6 || ~7 || ~8",
		"vue": "^3.2.0"
	}
}
